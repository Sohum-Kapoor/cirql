# Copy to .env (gitignored). Server-side only; never referenced from a cl block.
GOOGLE_API_KEY=            # Gemini via byLLM (Best of Google). Model pinned in jac.toml [plugins.byllm.model]
ELEVENLABS_API_KEY=        # speech-to-text for voice capture; TTS/agent are Tier 2
ELEVENLABS_VOICE_ID=       # optional; default 21m00Tcm4TlvDq8ikWAM (Rachel) if unset - used by Brief's spoken recap TTS
GEMINI_MODEL=              # optional; default gemini/gemini-3.8-flash (see llm.sv.jac)
JWT_SECRET=                # required on any hosted server: `openssl rand -hex 32`
# SSO (SOH-237, [plugins.scale.sso.*] in jac.toml). Empty = that button stays
# hidden (AuthCard.cl.jac probes /sso/<platform>/login on mount).
GOOGLE_OAUTH_CLIENT_ID=     # Google Cloud Console OAuth client; redirect URI <host>/sso/google/callback
GOOGLE_OAUTH_CLIENT_SECRET= # same OAuth client's secret
APPLE_SSO_CLIENT_ID=        # Apple "Sign in with Apple" Services ID; Return URL <host>/sso/apple/callback
APPLE_SSO_TEAM_ID=          # Apple Developer team id
APPLE_SSO_KEY_ID=           # Sign in with Apple private key's key id
APPLE_SSO_PRIVATE_KEY=      # the .p8 private key contents (PEM)
