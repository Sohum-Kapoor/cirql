# Copy to .env (gitignored). Server-side only; never referenced from a cl block.
GOOGLE_API_KEY=            # Gemini via byLLM (Best of Google). Model pinned in jac.toml [plugins.byllm.model]
ELEVENLABS_API_KEY=        # speech-to-text for voice capture; TTS/agent are Tier 2
ELEVENLABS_VOICE_ID=       # optional; default 21m00Tcm4TlvDq8ikWAM (Rachel) if unset - used by Brief's spoken recap TTS
GEMINI_MODEL=              # optional; default gemini/gemini-3.8-flash (see llm.sv.jac)
JWT_SECRET=                # required on any hosted server: `openssl rand -hex 32`
